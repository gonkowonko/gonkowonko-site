---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/home/ProjectCard.astro';
import NightscoutVisual from '../components/home/NightscoutVisual.astro';
import RewaxVisual from '../components/home/RewaxVisual.astro';
import { author, projects } from '../config/projects';
import { asset } from '../lib/asset';

const [nightscout, rewax] = projects;
const home = new URL(asset('/'), Astro.site).href;
const person = { '@type': 'Person', name: author.name, url: author.github };
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'gonkowonko', url: home, inLanguage: 'en-GB', author: person },
    {
      '@type': 'ItemList',
      name: 'Projects',
      itemListElement: projects.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name, url: new URL(p.href, Astro.site).href })),
    },
  ],
};
const year = new Date().getFullYear();
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonld)} />

  <div class="mx-auto max-w-[1080px] px-4 sm:px-8">
    <header class="flex items-center justify-between py-6 text-sm">
      <a href={asset('/')} class="font-semibold tracking-tight text-white">gonkowonko</a>
      <nav class="flex gap-5 text-white/55">
        <a href={author.github} rel="noopener" class="hover:text-white">GitHub</a>
      </nav>
    </header>

    <main>
      <section class="pt-20 pb-20 sm:pt-28 sm:pb-24">
        <h1 class="max-w-[16ch] text-4xl leading-[1.08] font-semibold tracking-[-0.03em] text-white text-balance sm:text-6xl">
          Small apps for things I actually use.
        </h1>
        <p class="mt-6 max-w-[56ch] text-lg leading-relaxed text-white/55 text-pretty">
          I’m {author.name}. I build apps to solve problems I run into myself, and I keep them simple.
          I live with type 1 diabetes and spend a lot of time on the bike, so that’s where a lot of them start.
        </p>
      </section>

      <section aria-labelledby="projects-heading">
        <h2 id="projects-heading" class="sr-only">Projects</h2>

        <div class="space-y-6">
          <ProjectCard project={nightscout} tint="radial-gradient(90% 80% at 70% 100%, #0f2a3d 0%, transparent 70%), #0b1119">
            <NightscoutVisual />
          </ProjectCard>
          <ProjectCard project={rewax} tint="radial-gradient(70% 70% at 50% 100%, #ffb2241f 0%, transparent 70%), #111210" reverse>
            <RewaxVisual />
          </ProjectCard>
        </div>
      </section>
    </main>

    <footer class="mt-24 flex flex-col gap-3 border-t border-white/[0.08] py-8 text-sm text-white/40 sm:flex-row sm:justify-between">
      <p>© {year} {author.name}</p>
      <a href={author.github} rel="noopener" class="hover:text-white">github.com/gonkowonko</a>
    </footer>
  </div>

  <script>
    import '../scripts/home';
  </script>
</Base>

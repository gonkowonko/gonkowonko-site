---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Email from '../../components/Email.astro';
import Wordmark from '../../components/rewax/Wordmark.astro';
import Phone from '../../components/rewax/Phone.astro';
import ChainBar from '../../components/rewax/ChainBar.astro';
import { asset } from '../../lib/asset';
import { author } from '../../config/projects';

import iList from '../../assets/rewax/iphone/bikes.png';
import iBike from '../../assets/rewax/iphone/bike.png';
import iHistory from '../../assets/rewax/iphone/history.png';
import iLogWax from '../../assets/rewax/iphone/log-wax.png';
import iWidget from '../../assets/rewax/iphone/home-widget.png';
import aList from '../../assets/rewax/android/bikes.png';
import aBike from '../../assets/rewax/android/bike.png';
import aHistory from '../../assets/rewax/android/history.png';
import aLogWax from '../../assets/rewax/android/log-wax.png';
import aWidget from '../../assets/rewax/android/home-widget.png';

// The app: one screen leads, the bike's page, with what it shows; two smaller
// ones support it. The screenshots come in matching pairs from the same demo
// data in each app; the visitor's phone is shown (data-phone on <html>), and
// the switch changes it. The bike list isn't here: it's the hero.
const lead = {
  title: 'Where each chain stands',
  text: 'A bike’s page leads with how far it is under or over its limit, then when it was waxed and when it’s due next.',
  specs: [
    ['Forecast', 'From the last four weeks of riding, roughly when the next wax is due.'],
    ['Limits', 'One for every bike, or its own for the bike that sees the worst of the weather. Miles or kilometres.'],
    ['Chain link', 'How many more uses a reusable quick link has left.'],
  ],
  iphone: iBike,
  android: aBike,
  alt: 'A bike’s page: the Canyon Aeroad 50 miles over its limit, last waxed on 20 September, with its chain link’s uses and the Log chain wax button.',
};
const supporting = [
  {
    title: 'Waxed it? Log it.',
    text: 'The count starts again from zero. Backdate it up to a year, add a note, or log it straight from the reminder.',
    iphone: iLogWax,
    android: aLogWax,
    alt: 'Logging a wax: the date and time it was waxed, and an optional note.',
  },
  {
    title: 'How long each wax lasts',
    text: 'A bar for every wax against the limit, with your average, shortest and longest. Chain links get the same chart.',
    iphone: iHistory,
    android: aHistory,
    alt: 'A bike’s history: a bar for each wax showing how far it lasted against the limit, and the average, shortest and longest.',
  },
];
// The wax cycle's chain: 10 plates, as the app draws a bike's chain, the app's
// default limit (300 mi), and where it rests without scripts. pinAt places the
// scale's marks, at 0, 75% and the limit, as a share of the chain's width
// (ChainBar's pins sit at 10 + 31k of 31n + 20).
const cycle = { plates: 10, limit: 300, rest: 0.84 };
const pinAt = (k: number) => ((10 + k * 31) / (cycle.plates * 31 + 20)) * 100;
const platforms = [
  {
    id: 'iphone',
    name: 'iPhone',
    needs: 'iOS 26 or later',
    widget: iWidget,
    widgetAlt: 'The Rewax bikes overview widget on an iPhone Home Screen: Canyon Aeroad 50 miles over, with two more bikes below.',
    points: ['Home Screen and Lock Screen widgets', 'Overdue bikes counted on the app icon', 'Liquid Glass, as iOS 26 draws it'],
  },
  {
    id: 'android',
    name: 'Android',
    needs: 'Android 12 or later',
    widget: aWidget,
    widgetAlt: 'The Rewax bikes overview widget on an Android home screen: Canyon Aeroad 50 miles over, with two more bikes below.',
    points: ['Widgets that resize, from one bike to all of them', 'Overdue alerts with a Log wax button on them', 'Material 3, as Android draws it'],
  },
];
// Privacy, as the privacy policy says it (/rewax/privacy-policy.html): what's
// read from Strava, and what never is.
const privacy = {
  facts: [
    ['Account', 'None'],
    ['Tracking', 'None'],
    ['Talks to', 'Strava only'],
  ],
  reads: [
    'Your name, to show which account is connected',
    'Your bikes: name, total distance, and whether they’re retired',
    'Your rides: name, date, distance and bike, private ones included, so every ride counts',
  ],
  never: [
    'Reading routes, locations, heart rate, power or photos',
    'Posting, editing or deleting anything on Strava',
    'Sending your data to anyone else',
  ],
};
// Questions the sections above don't already answer. Data has a section of
// its own.
const faqs = [
  ['Which rides count?', 'Any activity on Strava with that bike chosen for it, indoors or out, from a Garmin, a Wahoo, Zwift or anything else. A ride with no bike set doesn’t count; set one on Strava and it’s counted on the next sync.'],
  ['What limit should I set?', 'Rewax starts at 300 miles (483 km) for every bike. Change it for all of them, or give one bike its own: a lower one for the bike that rides in the wet, say. Miles or kilometres.'],
  ['What happens when I get a new phone?', 'Your wax log comes with you. iCloud Backup and Backup by Google include Rewax like any other app; on Android, connect Strava again afterwards. Or save a backup file from Settings → Backup & restore and restore it on the new phone, iPhone or Android. It shows what will change before anything’s replaced.'],
  ['Do I need a paid Strava subscription?', 'No, a free Strava account is all Rewax needs.'],
  ['Can I try it without Strava?', 'Yes. Choose Explore with demo data on the first screen and Rewax fills up with sample bikes, so you can try everything before connecting your own.'],
  ['When can I get it?', 'Rewax is being tested by a small group of riders at the moment. It’s coming to the App Store and Google Play once testing is done.'],
];

const page = new URL(asset('/rewax/'), Astro.site).href;
const site = new URL(asset('/'), Astro.site).href;
const person = { '@type': 'Person', name: author.name, url: author.github };
const app = (os: string, device: string) => ({
  '@type': 'SoftwareApplication',
  name: 'Rewax',
  description: `An ${device} app that counts how far each bike has been ridden since its chain was last waxed, from your Strava rides, and reminds you when it’s time to rewax.`,
  operatingSystem: os,
  applicationCategory: 'SportsApplication',
  image: new URL(asset('/rewax/icon-256.png'), Astro.site).href,
  url: page,
  featureList: ['Miles since each chain was waxed, from Strava', 'Limits for each bike', 'Overdue reminders', 'Chain link uses', 'Widgets', 'Backup and restore between iPhone and Android'],
  author: person,
});
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', name: 'Rewax', url: page, inLanguage: 'en-GB', isPartOf: { '@type': 'WebSite', name: 'gonkowonko', url: site }, author: person },
    app('iOS 26 or later', 'iPhone'),
    app('Android 12 or later', 'Android'),
    { '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ],
};

// The app's instrumentLabel: 11pt semibold capitals, 1.6pt tracking, dim.
const instrument = 'text-[11px] font-semibold tracking-[0.145em] text-rewax-dim uppercase';
const heroAlt = 'Rewax’s bike list: a Canyon Aeroad 50 miles over its limit, in red; a Specialized Tarmac SL9 with 45 miles left, in amber; and a Dolan DF5 with 108 miles left. Under each, a chain filled to how far it’s been ridden.';
---

<Base
  title="Rewax — know when to rewax your bike chain"
  description="Know when to rewax your bike chain. Rewax counts the miles on each chain since its last wax, from your Strava rides. For iPhone and Android, in closed beta."
  theme="rewax"
  siteName="Rewax"
  favicon="/rewax/favicon.png"
  touchIcon="/rewax/icon-256.png"
  themeColor="#111210"
  image="/rewax/og.png"
  imageAlt="Rewax on an iPhone: three bikes, each with the miles left or over since its chain was waxed, beside the words Know when to rewax your chain."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  <!-- Which phone's screenshots to show first: Android's for Android visitors,
       the iPhone's for everyone else. Set before the page draws, so the hero
       never swaps phones in front of you. -->
  <script is:inline slot="head">
    document.documentElement.dataset.phone = /Android/.test(navigator.userAgent) ? 'android' : 'iphone';
  </script>

  <div class="rewax-type mx-auto max-w-[1080px] px-4 sm:px-8">
    <!-- The wordmark as the app draws it in its toolbar, at the app's size. -->
    <header class="flex items-center justify-between py-5 text-sm">
      <div class="wordmark text-[12px] min-[360px]:text-[14px] sm:text-[16px]"><Wordmark /></div>
      <nav class="flex gap-2.5 text-[13px] text-rewax-dim min-[360px]:gap-4 min-[360px]:text-sm sm:gap-5" aria-label="On this page">
        <a href="#screens" class="hover:text-rewax-text">The app</a>
        <a href="#privacy" class="hover:text-rewax-text">Privacy</a>
        <a href="#faq" class="hover:text-rewax-text">FAQ</a>
      </nav>
    </header>

    <main>
      <!-- Hero: the promise, where Rewax stands, and the app itself, big
           enough to read. The phone stands on the rule under the hero, cut off
           below the last bike, where the screen is empty anyway. -->
      <section class="grid gap-y-8 border-b border-rewax-rule pt-6 sm:gap-y-10 sm:pt-12 md:grid-cols-[minmax(0,1fr)_300px] md:gap-x-12 lg:grid-cols-[minmax(0,1fr)_400px] lg:gap-x-20">
        <div class="md:self-center md:pb-14">
          <h1 class="max-w-[16ch] text-4xl leading-[1.05] font-semibold tracking-[-0.03em] text-balance sm:text-6xl md:text-5xl lg:text-6xl">Know when to rewax your chain.</h1>
          <p class="mt-5 max-w-[44ch] text-lg leading-relaxed text-rewax-body text-pretty">
            Waxing is easy. Remembering when isn’t. Rewax counts the miles on each chain from your Strava rides and tells you when it’s due.
          </p>
          <p class="mt-6 text-sm text-rewax-dim sm:mt-8">In closed beta. Coming to the App Store and Google Play.</p>
          <a href="#try" class="mt-2 inline-block text-sm text-rewax-text underline decoration-rewax-dim underline-offset-4 hover:decoration-rewax-text">Try it now: log a wax on the chain below</a>
        </div>
        <div class="mx-auto aspect-[400/650] min-h-0 w-[86vw] max-w-[360px] overflow-y-clip md:w-full md:max-w-none md:self-end">
          <div class="iphone"><Phone src={iList} alt={heroAlt} platform="iphone" sizes="(min-width: 1024px) 400px, (min-width: 768px) 300px, 86vw" eager /></div>
          <div class="android"><Phone src={aList} alt={heroAlt} platform="android" sizes="(min-width: 1024px) 400px, (min-width: 768px) 300px, 86vw" eager /></div>
        </div>
      </section>

      <!-- The wax cycle: one wax's life on a chain, drawn and animated as the
           app draws it. -->
      <section id="how" class="scroll-mt-8 pt-24 sm:pt-36">
        <h2 class="text-3xl leading-tight font-semibold tracking-tight text-balance sm:text-5xl">Every ride fills the chain.</h2>

        <!-- Read-only, so no panel: a bike page's headline, figure and chain,
             between hairlines. Without scripts it rests at 48 miles left. -->
        <div id="try" class="mt-10 scroll-mt-8 border-y border-rewax-rule py-8 sm:mt-14 sm:py-12" data-cycle data-limit={cycle.limit} data-state="amber">
          <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
            <div>
              <p class={`${instrument} state-label`} data-label>Left before rewax</p>
              <p class="mt-2 flex items-baseline gap-2.5 sm:gap-4">
                <span class="figure text-[112px] leading-[0.85] sm:text-[160px] lg:text-[184px]" data-figure>{cycle.limit - Math.round(cycle.rest * cycle.limit)}</span>
                <span class="text-lg text-rewax-dim sm:text-2xl" data-unit>mi</span>
              </p>
              <p class="mt-3 text-sm text-rewax-dim tnum" data-ridden>{Math.round(cycle.rest * cycle.limit)} mi ridden on this wax, limit {cycle.limit}</p>
            </div>
            <button type="button" hidden data-log class="min-h-14 w-full rounded-[14px] bg-rewax-text px-8 text-base font-bold tracking-[0.1375em] text-rewax-background uppercase transition-[transform,opacity] duration-100 ease-out select-none hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-rewax-text active:scale-[0.98] sm:w-auto">Log chain wax</button>
          </div>

          <div class="mt-8 sm:mt-10"><ChainBar plates={cycle.plates} fraction={cycle.rest} /></div>
          <!-- The scale under the chain is the whole story: wax, due soon, rewax. -->
          <div class="relative mt-3 h-11 text-xs leading-snug" aria-hidden="true">
            {[
              { at: pinAt(0), name: 'Wax', value: '0 mi', align: '' },
              { at: pinAt(cycle.plates * 0.75), name: 'Due soon', value: '75%', align: '-translate-x-full text-right sm:-translate-x-1/2 sm:text-center' },
              { at: pinAt(cycle.plates), name: 'Rewax', value: `${cycle.limit} mi`, align: '-translate-x-full text-right' },
            ].map((m) => (
              <div class:list={['absolute top-0 pt-1 whitespace-nowrap', m.align]} style={`left: ${m.at}%`}>
                <p class={instrument}>{m.name}</p>
                <p class="text-rewax-body tnum">{m.value}</p>
              </div>
            ))}
          </div>
          <p class="mt-6 text-rewax-body">Every Strava ride on that bike adds its miles.</p>
        </div>

      </section>

      <!-- The app: one switch for the page's screenshots, then one screen that
           leads, big, and two that support it, smaller, side by side. (Not cut
           off like the hero's: the Log wax sheet runs to the foot of the screen.) -->
      <section id="screens" class="scroll-mt-8 pt-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <p class="text-sm text-rewax-dim">Real screens from both apps, with the same demo bikes.</p>
          <div class="relative flex rounded-full border border-rewax-panel-border bg-rewax-panel p-1 text-sm" role="group" aria-label="Show screens from" data-switch>
            <span data-pill aria-hidden="true" class="absolute inset-y-1 left-1 rounded-full bg-rewax-text transition-all duration-300 ease-out"></span>
            {platforms.map((p) => (
              <button type="button" aria-pressed="false" data-platform={p.id} class="relative z-10 rounded-full px-5 py-2 font-medium text-rewax-body transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rewax-text aria-pressed:text-rewax-background">
                {p.name}
              </button>
            ))}
          </div>
        </div>

        <article class="mt-12 grid items-center gap-10 sm:mt-16 md:grid-cols-[300px_minmax(0,1fr)] md:gap-12 lg:grid-cols-[380px_minmax(0,1fr)] lg:gap-20">
          <div class="mx-auto w-[78vw] max-w-[320px] md:w-full md:max-w-none">
            <div class="iphone"><Phone src={lead.iphone} alt={lead.alt} platform="iphone" sizes="(min-width: 1024px) 380px, (min-width: 768px) 300px, 78vw" /></div>
            <div class="android"><Phone src={lead.android} alt={lead.alt} platform="android" sizes="(min-width: 1024px) 380px, (min-width: 768px) 300px, 78vw" /></div>
          </div>
          <div class="max-w-[34rem]">
            <h2 class="text-3xl leading-tight font-semibold tracking-tight text-balance sm:text-5xl">{lead.title}</h2>
            <p class="mt-5 text-lg leading-relaxed text-rewax-body text-pretty">{lead.text}</p>
            <dl class="mt-8 border-b border-rewax-rule">
              {lead.specs.map(([t, d]) => (
                <div class="border-t border-rewax-rule py-3.5">
                  <dt class="font-semibold">{t}</dt>
                  <dd class="mt-0.5 text-sm leading-relaxed text-rewax-dim">{d}</dd>
                </div>
              ))}
            </dl>
          </div>
        </article>

        <div class="mt-20 grid gap-16 sm:mt-28 md:grid-cols-2 md:gap-12 lg:gap-20">
          {supporting.map((c) => (
            <article class="flex flex-col">
              <h3 class="text-2xl leading-tight font-semibold tracking-tight text-balance">{c.title}</h3>
              <p class="mt-3 max-w-[40ch] leading-relaxed text-rewax-body text-pretty">{c.text}</p>
              <div class="mt-auto border-b border-rewax-rule pt-8">
                <div class="mx-auto w-[64vw] max-w-[260px]">
                  <div class="iphone"><Phone src={c.iphone} alt={c.alt} platform="iphone" sizes="(min-width: 768px) 260px, 64vw" /></div>
                  <div class="android"><Phone src={c.android} alt={c.alt} platform="android" sizes="(min-width: 768px) 260px, 64vw" /></div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- On your phone: each phone's widget and what's its own, side by side
           and read-only (hairlines, no cards). -->
      <section class="mt-24 sm:mt-32">
        <h2 class="text-3xl leading-tight font-semibold tracking-tight text-balance sm:text-4xl">Your chains, on your home screen</h2>

        <div class="mt-12 grid gap-14 md:grid-cols-2 md:gap-0">
          {platforms.map((p, i) => (
            <div class:list={[i === 0 ? 'md:pr-10' : 'md:border-l md:border-rewax-rule md:pl-10']}>
              <Image src={p.widget} alt={p.widgetAlt} widths={[400, 800]} sizes="(min-width: 1024px) 460px, (min-width: 768px) 45vw, 92vw" class="w-full rounded-2xl" />
              <h3 class="mt-7 text-xl font-semibold tracking-tight">{p.name}</h3>
              <p class="mt-0.5 text-sm text-rewax-dim">Needs {p.needs}</p>
              <ul class="mt-4 border-b border-rewax-rule">
                {p.points.map((pt) => <li class="border-t border-rewax-rule py-3 text-rewax-body">{pt}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Privacy: the short version as the app's readouts, then exactly what
           Rewax reads from Strava and what it never does. -->
      <section id="privacy" class="mt-24 scroll-mt-8 sm:mt-32">
        <div class="grid gap-4 md:grid-cols-2 md:items-end md:gap-12">
          <h2 class="text-3xl leading-tight font-semibold tracking-tight text-balance sm:text-4xl">Your data stays on your phone.</h2>
          <p class="max-w-[46ch] leading-relaxed text-rewax-body text-pretty">Rewax has no account, no server of its own, no ads and no analytics. Your bikes, wax log and chain links are kept on your phone.</p>
        </div>

        <dl class="mt-10 grid grid-cols-3 border-y border-rewax-rule sm:mt-12">
          {privacy.facts.map(([t, d], i) => (
            <div class:list={['py-5 sm:py-7', i > 0 && 'border-l border-rewax-rule pl-4 sm:pl-6']}>
              <dt class={instrument}>{t}</dt>
              <dd class="mt-2 text-lg font-semibold tracking-tight whitespace-nowrap sm:text-3xl lg:text-4xl">{d}</dd>
            </div>
          ))}
        </dl>

        <div class="mt-12 grid gap-10 md:grid-cols-2 md:gap-12">
          {[['What it reads from Strava', privacy.reads], ['What it never does', privacy.never]].map(([t, items]) => (
            <div>
              <h3 class={instrument}>{t}</h3>
              <ul class="mt-3 border-b border-rewax-rule text-sm">
                {(items as string[]).map((item) => <li class="border-t border-rewax-rule py-2.5 text-rewax-body">{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <p class="mt-6 text-sm text-rewax-body">
          The <a href={asset('/rewax/privacy-policy.html')} class="text-rewax-text underline decoration-rewax-dim underline-offset-4 hover:decoration-rewax-text">privacy policy</a> has the details.
        </p>
      </section>

      <!-- Questions: few and short, so they're all open, question beside
           answer, read-only between hairlines. -->
      <section id="faq" class="mt-28 scroll-mt-8 border-t border-rewax-rule pt-10 sm:pt-14">
        <h2 class="text-3xl leading-tight font-semibold tracking-tight sm:text-4xl">Questions</h2>
        <dl class="mt-10 border-b border-rewax-rule">
          {faqs.map(([q, a]) => (
            <div class="grid gap-2 border-t border-rewax-rule py-6 md:grid-cols-2 md:gap-12">
              <dt class="text-lg font-semibold tracking-tight">{q}</dt>
              <dd class="max-w-[60ch] leading-relaxed text-rewax-body text-pretty">{a}</dd>
            </div>
          ))}
        </dl>
      </section>
    </main>

    <!-- The end of the page: the mark again, where Rewax stands, how to get
         in touch, and who made it, with Strava's independence line. -->
    <footer class="mt-24 pb-10 text-sm">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <div class="wordmark text-[16px]"><Wordmark id="rewax-footer" /></div>
          <p class="mt-4 text-rewax-body">For waxed chains, on iPhone and Android.</p>
          <p class="mt-1 text-rewax-dim">In closed beta. Coming to the App Store and Google Play.</p>
        </div>
        <ul class="flex flex-col gap-2.5 text-rewax-body sm:items-end [&_a]:underline-offset-4 [&_a:hover]:text-rewax-text [&_a:hover]:underline">
          <li><a href={asset('/rewax/privacy-policy.html')}>Privacy policy</a></li>
          <li><Email user="rewax" domain="gonkowonko.com" /></li>
        </ul>
      </div>
      <div class="mt-10 flex flex-col gap-2 border-t border-rewax-rule pt-6 text-rewax-dim sm:flex-row sm:justify-between sm:gap-8">
        <p>Rewax is an independent app. It isn’t made, sponsored or endorsed by Strava.</p>
        <p class="shrink-0">Made by Gary Dalley · <a href={asset('/')} class="underline-offset-4 hover:text-rewax-text hover:underline">gonkowonko.com</a></p>
      </div>
    </footer>
  </div>

  <script>
    // The iPhone / Android switch. It sets data-phone on <html>, which says
    // whose screenshots show everywhere on the page; the head set it first,
    // to the visitor's own phone.
    const group = document.querySelector<HTMLElement>('[data-switch]')!;
    const pill = group.querySelector<HTMLElement>('[data-pill]')!;
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('[data-platform]')];

    function place() {
      const on = buttons.find((b) => b.getAttribute('aria-pressed') === 'true')!;
      pill.style.width = `${on.offsetWidth}px`;
      pill.style.transform = `translateX(${on.offsetLeft - 4}px)`;
    }
    function show(id: string) {
      document.documentElement.dataset.phone = id;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.platform === id)));
      place();
    }
    buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.platform!)));
    show(document.documentElement.dataset.phone ?? 'iphone');
    new ResizeObserver(place).observe(buttons[0]);
    document.fonts?.ready.then(place);
  </script>
</Base>

<script>
  // The wax cycle: a wax ridden up to its limit and a little past, the chain
  // filling plate by plate as it walks neutral, amber, red, and Log chain wax
  // emptying it again, as the app animates it. It starts once the chain itself
  // is in view; with reduced motion it jumps straight to each end.
  const cycle = document.querySelector<HTMLElement>('[data-cycle]');
  if (cycle) {
    const limit = Number(cycle.dataset.limit);
    const plates = [...cycle.querySelectorAll<SVGElement>('[data-plate]')];
    const count = new Set(plates.map((p) => p.dataset.plate)).size;
    const find = (name: string) => cycle.querySelector<HTMLElement>(`[data-${name}]`)!;
    const [label, figure, unit, ridden] = ['label', 'figure', 'unit', 'ridden'].map(find);
    const button = find('log') as HTMLButtonElement;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const end = 1.04;
    let fraction = 0;
    let run = 0;

    cycle.querySelector('svg')!.style.setProperty('--chain-fill', 'var(--state)');

    function draw(value: number, moving: boolean) {
      fraction = value;
      const level = Math.min(Math.max(value, 0), 1) * count;
      for (const p of plates) {
        const amount = Math.min(Math.max(level - Number(p.dataset.plate), 0), 1);
        p.setAttribute('opacity', String(moving ? amount : amount >= 1 ? 1 : 0));
      }
      const miles = Math.round(value * limit);
      const left = limit - miles;
      cycle!.dataset.state = value >= 1 ? 'red' : value >= 0.75 ? 'amber' : 'text';
      label.textContent = left < 0 ? 'Over the limit' : 'Left before rewax';
      figure.textContent = String(Math.abs(left));
      unit.textContent = left < 0 ? 'mi over' : 'mi';
      ridden.textContent = `${miles} mi ridden on this wax, limit ${limit}`;
    }

    function go(to: number, ms: number, then?: () => void) {
      const id = ++run;
      const from = fraction;
      if (still) {
        draw(to, false);
        then?.();
        return;
      }
      const start = performance.now();
      const tick = (now: number) => {
        if (id !== run) return;
        const t = Math.min((now - start) / ms, 1);
        const eased = t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2;
        draw(from + (to - from) * eased, t < 1);
        if (t < 1) requestAnimationFrame(tick);
        else then?.();
      };
      requestAnimationFrame(tick);
    }

    const ride = () => go(end, 4200);
    draw(0, false);
    button.hidden = false;
    button.addEventListener('click', () => {
      const id = run + 1;
      go(0, 1200, () => setTimeout(() => id === run && ride(), 900));
    });
    new IntersectionObserver(
      (entries, observer) => {
        if (!entries[0].isIntersecting) return;
        observer.disconnect();
        ride();
      },
      { threshold: 1 },
    ).observe(cycle.querySelector('svg')!);
  }
</script>


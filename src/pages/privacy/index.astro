---
import { asset } from '../../lib/asset';

// The Nightscout apps' privacy page used to live here, before the site root
// became the portfolio. GitHub Pages can't redirect, so this page does.
const to = asset('/nightscout/privacy/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved: Privacy — NightscoutBar & NightscoutWidget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(to, Astro.site)} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p>This page has moved to <a href={to}>{new URL(to, Astro.site).href}</a>.</p>
  </body>
</html>

---
import { faqs } from '../config/faq';
---

<section id="faq" class="relative px-4 py-24 sm:py-32 scroll-mt-16">
  <div class="mx-auto max-w-3xl">
    <h2 data-reveal class="text-center text-4xl font-bold tracking-tight sm:text-5xl">Questions</h2>
    <div data-stagger class="mt-12 space-y-3">
      {faqs.map(([q, a]) => (
        <details class="glass group rounded-2xl px-5 open:bg-white/[0.06]">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium">
            {q}
            <span class="grid size-7 shrink-0 place-items-center rounded-full bg-white/5 transition-transform duration-300 group-open:rotate-45">
              <svg class="size-3.5" viewBox="0 0 12 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 1v10M1 6h10"/></svg>
            </span>
          </summary>
          <p class="pb-5 text-fg/60 text-pretty">{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

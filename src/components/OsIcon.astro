---
// Neutral device icons: no Apple or Microsoft logos (their trademark rules don't allow them here).
interface Props { os: 'mac' | 'win'; class?: string }
const { os, class: cls = 'size-5' } = Astro.props;
---
{os === 'mac' ? (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4.5" width="16" height="11" rx="1.8"/><path d="M2 19.5h20"/></svg>
) : (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3.5" width="18" height="12.5" rx="1.8"/><path d="M9 20.5h6M12 16v4.5"/></svg>
)}

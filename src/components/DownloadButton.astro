---
import { apps, type AppKey } from '../config/downloads';
import OsIcon from './OsIcon.astro';
interface Props { app: AppKey; size?: 'md' | 'lg' }
const { app, size = 'lg' } = Astro.props;
const a = apps[app];
---
<a
  href={a.download}
  target="_blank"
  rel="noopener"
  data-dl={app}
  class:list={[
    'btn-glow group inline-flex items-center gap-3 font-semibold transition-transform duration-300 hover:-translate-y-0.5 active:translate-y-0',
    size === 'lg' ? 'px-6 py-3.5 text-base' : 'px-4 py-2.5 text-sm',
  ]}
>
  <OsIcon os={app} class={size === 'lg' ? 'size-5' : 'size-4'} />
  <span class="flex flex-col leading-tight text-left">
    <span>Download for {a.platform}</span>
    {size === 'lg' && <span class="text-xs font-medium opacity-60">{a.file} · {a.requirements}</span>}
  </span>
  <svg class="size-4 transition-transform group-hover:translate-y-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 2v9m0 0L4.5 7.5M8 11l3.5-3.5M3 14h10" stroke-linecap="round" stroke-linejoin="round"/></svg>
</a>

---
import { apps, type AppKey } from '../config/downloads';
import OsIcon from './OsIcon.astro';
// A download link, with what it downloads and what it needs underneath. The
// visitor's own platform (data-os on <html>, set in Base) is filled in; on a
// phone, or anything else, both stay outlined.
interface Props { app: AppKey }
const { app } = Astro.props;
const a = apps[app];
---
<a
  href={a.download}
  data-dl={app}
  class="dl flex min-h-14 items-center gap-3.5 rounded-[14px] border border-ns-rule px-4 py-2.5 transition-[background-color,border-color,opacity] hover:border-dim focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
>
  <OsIcon os={app} class="size-5 shrink-0" />
  <span class="flex flex-col leading-snug">
    <span class="font-semibold">Download for {a.platform}</span>
    <span class="dl-meta text-xs text-dim">{a.name} · {a.file} · {a.requirements}</span>
  </span>
</a>

<style>
  :global([data-os='mac']) .dl[data-dl='mac'],
  :global([data-os='win']) .dl[data-dl='win'] {
    background: var(--color-fg);
    border-color: var(--color-fg);
    color: var(--color-ink);
  }
  :global([data-os='mac']) .dl[data-dl='mac']:hover,
  :global([data-os='win']) .dl[data-dl='win']:hover {
    opacity: 0.9;
  }
  :global([data-os='mac']) .dl[data-dl='mac'] .dl-meta,
  :global([data-os='win']) .dl[data-dl='win'] .dl-meta {
    color: #05080fa6;
  }
</style>

---
import MacDemo from './MacDemo.astro';
import WinDemo from './WinDemo.astro';
---

<section id="demo" class="relative px-4 py-24 sm:py-32 scroll-mt-10">
  <div class="mx-auto max-w-3xl text-center">
    <p data-reveal class="text-sm font-semibold tracking-widest text-accent uppercase">Live demo</p>
    <h2 data-reveal class="mt-3 text-4xl font-bold tracking-tight text-balance sm:text-5xl">See it working before you install it.</h2>
    <p data-reveal class="mt-4 text-lg text-fg/60 text-pretty">
      These are working copies of the real apps, fed by made-up readings that update every few seconds. Click the menu bar reading, switch the chart range, or drag the Windows widget around.
    </p>
  </div>

  <div data-reveal class="mx-auto mt-10 flex max-w-5xl flex-wrap items-center justify-center gap-3">
    <div class="glass relative flex rounded-full p-1" role="tablist" aria-label="Platform">
      <span data-tab-pill class="absolute inset-y-1 left-1 rounded-full bg-fg transition-all duration-500 ease-[cubic-bezier(.3,1.5,.5,1)]"></span>
      <button type="button" role="tab" data-tab="mac" class="relative z-10 flex items-center gap-2 rounded-full px-5 py-2 text-sm font-semibold transition-colors">macOS · NightscoutBar</button>
      <button type="button" role="tab" data-tab="win" class="relative z-10 flex items-center gap-2 rounded-full px-5 py-2 text-sm font-semibold transition-colors">Windows · NightscoutWidget</button>
    </div>
    <div class="glass flex rounded-full p-1 text-sm" aria-label="Units">
      <button type="button" data-unit="mmol" class="rounded-full px-3 py-2 font-medium transition-colors">mmol/L</button>
      <button type="button" data-unit="mgdl" class="rounded-full px-3 py-2 font-medium transition-colors">mg/dL</button>
    </div>
  </div>

  <div class="mx-auto mt-10 max-w-5xl [perspective:1600px]">
    <div data-stage-frame class="relative rounded-[22px] border border-white/10 bg-white/5 p-2 shadow-[0_60px_120px_-40px_#39c5ff55,0_0_0_1px_#ffffff08]">
      <div data-scale-box data-desktop="960x600" data-mobile="560x620" class="relative aspect-[8/5] w-full overflow-hidden rounded-[16px]">
        <div data-scale-inner class="absolute left-0 top-0 h-[600px] w-[960px] origin-top-left">
          <div data-panel="mac" class="absolute inset-0"><MacDemo /></div>
          <div data-panel="win" class="absolute inset-0 invisible opacity-0"><WinDemo /></div>
        </div>
      </div>
    </div>
    <p class="mt-4 text-center text-xs text-fg/40">Demo data only. Nothing on this page connects to a real Nightscout site.</p>
  </div>
</section>

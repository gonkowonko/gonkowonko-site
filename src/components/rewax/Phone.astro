---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A Rewax screenshot in a plain phone outline. The screenshots are the
// simulators' own captures (the iPhone 17 Pro's and the Pixel 9's), which
// leave out the camera cut-out, so it's drawn back on here: the Dynamic Island
// on the iPhone and the punch-hole camera on Android. The screen's corners
// follow each display's: 62 of 402 points on the iPhone, 110 of 1080 pixels
// on the Pixel, given as horizontal / vertical percentages of the capture.
interface Props {
  src: ImageMetadata;
  alt: string;
  platform: 'iphone' | 'android';
  sizes: string;
  class?: string;
  /** Load straight away, for pictures in the first screenful. */
  eager?: boolean;
}
const { src, alt, platform, sizes, class: className, eager = false } = Astro.props;
const iphone = platform === 'iphone';
const screen = iphone ? 'rounded-[15.4%/7.1%]' : 'rounded-[10.2%/4.55%]';
const body = iphone ? 'rounded-[17%/7.9%]' : 'rounded-[12.4%/5.6%]';
---

<div class:list={['phone relative bg-[#1c1d1a] p-[2.6%] shadow-[0_0_0_1px_#ffffff14,0_40px_80px_-30px_#000]', body, className]}>
  <div class="relative">
    <Image {src} {alt} widths={[300, 600, 900]} {sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} class:list={['block h-auto w-full', screen]} />
    {iphone ? (
      <span aria-hidden="true" class="absolute top-[1.3%] left-1/2 h-[4.2%] w-[31%] -translate-x-1/2 rounded-full bg-black"></span>
    ) : (
      <span aria-hidden="true" class="absolute top-[2.1%] left-1/2 aspect-square w-[3.5%] -translate-x-1/2 rounded-full bg-black"></span>
    )}
  </div>
</div>

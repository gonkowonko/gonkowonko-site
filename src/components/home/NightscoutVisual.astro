---
import { Image } from 'astro:assets';
import bar from '../../assets/home/nightscoutbar.png';
import widget from '../../assets/home/nightscoutwidget.png';
// The Nightscout card's picture: the apps' own screenshots, from the docs in
// their repos. NightscoutBar's menu bar and popover, cut off by the card's
// right edge and foot, with NightscoutWidget over its lower left.
const shot = 'absolute shadow-[0_30px_60px_-20px_#000c] ring-1 ring-white/10';
---

<div class="absolute inset-0 overflow-hidden" aria-hidden="true">
  <Image src={bar} alt="" widths={[480, 900]} sizes="(min-width: 1024px) 480px, 88vw" class:list={[shot, 'top-8 left-[14%] w-[86%] max-w-none rounded-tl-xl']} />
  <Image src={widget} alt="" widths={[260, 520]} sizes="(min-width: 1024px) 240px, 46vw" class:list={[shot, 'bottom-7 left-7 w-[46%] max-w-[260px] rounded-[5.2%/8.8%] sm:bottom-9 sm:left-10']} />
</div>

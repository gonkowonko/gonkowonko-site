---
import Phone from '../rewax/Phone.astro';
import iList from '../../assets/rewax/iphone/bikes.png';
// The Rewax card's picture, as the Rewax page's hero has it: the bike list,
// straight on, rising out of the foot of the card and cut off by it.
---

<div class="absolute inset-x-0 top-8 bottom-0 flex justify-center overflow-hidden" aria-hidden="true">
  <Phone src={iList} alt="" platform="iphone" sizes="(min-width: 1024px) 260px, 60vw" class="h-fit w-[60%] max-w-[260px]" />
</div>

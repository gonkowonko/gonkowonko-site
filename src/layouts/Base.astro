---
import { asset } from '../lib/asset';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Nightscout desktop apps for Mac and Windows — NightscoutBar & NightscoutWidget',
  description = 'Free, open-source apps that show your Nightscout CGM glucose on your desktop: a macOS menu bar app and a floating Windows widget, with trend arrow, chart, IOB and COB.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(asset('/og.png'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05080f" />
    {import.meta.env.PUBLIC_NOINDEX && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href={asset("/favicon.png")} />
    <link rel="apple-touch-icon" href={asset("/icons/nightscoutbar-256.png")} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={asset('/sitemap-index.xml')} />
    <meta property="og:site_name" content="NightscoutBar & NightscoutWidget" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="NightscoutBar and NightscoutWidget: Nightscout glucose on your Mac and Windows desktop" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add('js');
      (function () {
        var ua = navigator.userAgent, p = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || '';
        var os = /win/i.test(p) || /Windows/.test(ua) ? 'win' : /mac/i.test(p) || /Mac OS X/.test(ua) ? 'mac' : 'other';
        if (/iPhone|iPad|Android/.test(ua)) os = 'other';
        document.documentElement.dataset.os = os;
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <slot />
  </body>
</html>
